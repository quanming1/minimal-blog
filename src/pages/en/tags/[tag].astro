---
/** 标签筛选页（en）：/en/tags/<tag>/ */
import Base from '../../../layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import { sortPostsByDate } from '../../../lib/posts'
import { formatMonthDay, langOfId, parseDateString, postHref } from '../../../lib/utils'
import { t } from '../../../lib/i18n'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'en')
  const byTag = new Map<string, typeof posts>()
  for (const p of posts) {
    for (const tag of p.data.tags) {
      const list = byTag.get(tag) ?? []
      list.push(p)
      byTag.set(tag, list)
    }
  }
  return Array.from(byTag.entries()).map(([tag, list]) => ({
    params: { tag },
    props: { tag, posts: list },
  }))
}

const { tag, posts } = Astro.props
const base = import.meta.env.BASE_URL
const sorted = sortPostsByDate(
  posts.map((p) => ({ p, date: parseDateString(p.data.date) })),
).map((x) => x.p)
---

<Base
  lang="en"
  path={`/tags/${encodeURIComponent(tag)}/`}
  description={`Posts tagged "${tag}"`}
  pageTitle={`${t('en', 'tagPostsTitle', { tag })} · ${t('en', 'siteName')}`}
>
  <h1 class="posts-title">{t('en', 'tagPostsTitle', { tag })}</h1>

  <table class="posts-table">
    <tbody>
      {sorted.map((p) => (
        <tr>
          <td>
            <a href={postHref(base, 'en', p.id)}>{p.data.title}</a>
          </td>
          <td class="text-right whitespace-nowrap text-sm text-muted">
            {formatMonthDay(parseDateString(p.data.date), 'en')}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <a class="post-back" href={`${base}en/tags/`}>
    <Icon name="lucide:arrow-left" aria-hidden="true" /> {t('en', 'allTags')}
  </a>
</Base>
