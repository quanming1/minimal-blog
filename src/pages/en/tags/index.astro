---
/** 标签云页（en）：全部标签 + 文章数 */
import Base from '../../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { getAllTags } from '../../../lib/posts'
import { langOfId } from '../../../lib/utils'
import { t } from '../../../lib/i18n'

const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'en')
const tags = getAllTags(posts.map((p) => ({ tags: p.data.tags })))
const base = import.meta.env.BASE_URL
---

<Base lang="en" path="/tags/" description="Browse all posts by tag" pageTitle={`${t('en', 'tagsTitle')} · ${t('en', 'siteName')}`}>
  <h1 class="posts-title">{t('en', 'tagsTitle')}</h1>

  {tags.length > 0 ? (
    <div class="tags-cloud">
      {tags.map((tag) => (
        <a class="tag-link" href={`${base}en/tags/${encodeURIComponent(tag.tag)}/`}>
          {tag.tag}
          <span class="tag-count">({tag.count})</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="post-meta">{t('en', 'searchEmpty')}</p>
  )}
</Base>
