---
/** 专栏总览页（en）：全部专栏 + 文章数，点击进入 /en/columns/<column>/ 系列文章列表 */
import Base from '../../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { getAllColumns } from '../../../lib/posts'
import { langOfId } from '../../../lib/utils'
import { t } from '../../../lib/i18n'

const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'en')
const columns = getAllColumns(posts.map((p) => ({ column: p.data.column })))
const base = import.meta.env.BASE_URL
---

<Base lang="en" path="/columns/" description="Browse posts by column" pageTitle={`${t('en', 'columnsTitle')} · ${t('en', 'siteName')}`}>
  <h1 class="posts-title">{t('en', 'columnsTitle')}</h1>

  {columns.length > 0 ? (
    <div class="tags-cloud">
      {columns.map((c) => (
        <a class="tag-link" href={`${base}en/columns/${encodeURIComponent(c.column)}/`}>
          {c.column}
          <span class="tag-count">({c.count})</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="post-meta">{t('en', 'searchEmpty')}</p>
  )}
</Base>
