---
/** 专栏文章列表页（zh）：/columns/<column>/ 下该专栏的系列文章（columnOrder 升序，缺省按日期倒序） */
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { sortColumnPosts } from '../../lib/posts'
import { formatMonthDay, langOfId, parseDateString, postHref } from '../../lib/utils'
import { t } from '../../lib/i18n'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'zh')
  const byColumn = new Map<string, typeof posts>()
  for (const p of posts) {
    if (!p.data.column) continue
    const list = byColumn.get(p.data.column) ?? []
    list.push(p)
    byColumn.set(p.data.column, list)
  }
  return Array.from(byColumn.entries()).map(([column, list]) => ({
    params: { column },
    props: { column, posts: list },
  }))
}

const { column, posts } = Astro.props
const base = import.meta.env.BASE_URL
const sorted = sortColumnPosts(
  posts.map((p) => ({ p, date: parseDateString(p.data.date), columnOrder: p.data.columnOrder })),
).map((x) => x.p)
---

<Base
  lang="zh"
  path={`/columns/${encodeURIComponent(column)}/`}
  description={`专栏「${column}」下的系列文章`}
  pageTitle={`${t('zh', 'columnPostsTitle', { column })} · ${t('zh', 'siteName')}`}
>
  <h1 class="posts-title">{t('zh', 'columnPostsTitle', { column })}</h1>

  <table class="posts-table">
    <tbody>
      {sorted.map((p) => (
        <tr>
          <td>
            <a href={postHref(base, 'zh', p.id)}>{p.data.title}</a>
          </td>
          <td class="text-right whitespace-nowrap text-sm text-muted">
            {formatMonthDay(parseDateString(p.data.date), 'zh')}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <a class="post-back" href={`${base}columns/`}>{t('zh', 'allColumns')}</a>
</Base>
