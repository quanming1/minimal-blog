---
/** 专栏总览页（zh）：全部专栏 + 文章数，点击进入 /columns/<column>/ 系列文章列表 */
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { getAllColumns } from '../../lib/posts'
import { langOfId } from '../../lib/utils'
import { t } from '../../lib/i18n'

const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'zh')
const columns = getAllColumns(posts.map((p) => ({ column: p.data.column })))
const base = import.meta.env.BASE_URL
---

<Base lang="zh" path="/columns/" description="按专栏浏览系列文章" pageTitle={`${t('zh', 'columnsTitle')} · ${t('zh', 'siteName')}`}>
  <h1 class="posts-title">{t('zh', 'columnsTitle')}</h1>

  {columns.length > 0 ? (
    <div class="tags-cloud">
      {columns.map((c) => (
        <a class="tag-link" href={`${base}columns/${encodeURIComponent(c.column)}/`}>
          {c.column}
          <span class="tag-count">({c.count})</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="post-meta">{t('zh', 'searchEmpty')}</p>
  )}
</Base>
