---
import Base from '../layouts/Base.astro'
import PostList from '../components/PostList.astro'
import { getCollection } from 'astro:content'
import { langOfId } from '../lib/utils'

const posts = (await getCollection('posts', ({ id }) => langOfId(id) === 'zh'))
  .map((p) => ({ id: p.id, title: p.data.title, date: p.data.date }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
---

<Base lang="zh" path="/" description="明志 — 非淡泊无以明志，非宁静无以致远。技术笔记、阅读与思考。">
  <PostList lang="zh" posts={posts} />
</Base>
