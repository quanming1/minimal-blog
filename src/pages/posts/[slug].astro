---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { t } from '../../lib/i18n'
import { formatFullDate, langOfId, readingMinutes, slugOfId } from '../../lib/utils'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'zh')
  return posts.map((p) => ({
    params: { slug: slugOfId(p.id) },
    props: { post: p },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, date, description, tags } = post.data
const minutes = readingMinutes(post.body ?? '', 'zh')
---

<Base
  lang="zh"
  path={`/posts/${slugOfId(post.id)}/`}
  description={description ?? title}
  pageTitle={`${title} · ${t('zh', 'siteName')}`}
>
  <article>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        {t('zh', 'firstWritten')} {formatFullDate(date, 'zh')}
        <span class="min-read">{t('zh', 'minRead', { n: minutes })}</span>
      </p>
    </header>

    <div class="post-body">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <a class="post-back" href={`${import.meta.env.BASE_URL}`}>{t('zh', 'backHome')}</a>
  </article>
</Base>
