---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { t } from '../../lib/i18n'
import { formatFullDate, langOfId, parseDateString, readingMinutes, slugOfId } from '../../lib/utils'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'zh')
  const enPosts = await getCollection('posts', ({ id }) => langOfId(id) === 'en')
  const enSlugs = new Set(enPosts.map((p) => slugOfId(p.id)))
  return posts.map((p) => ({
    params: { slug: slugOfId(p.id) },
    props: { post: p, hasTranslation: enSlugs.has(slugOfId(p.id)) },
  }))
}

const { post, hasTranslation } = Astro.props
const { Content } = await render(post)
const { title, description, tags } = post.data
const date = parseDateString(post.data.date)
const minutes = readingMinutes(post.body ?? '', 'zh')
---

<Base
  lang="zh"
  path={`/posts/${slugOfId(post.id)}/`}
  description={description ?? title}
  pageTitle={`${title} · ${t('zh', 'siteName')}`}
  hasTranslation={hasTranslation}
>
  <article>
    <header class="post-header">
      <h2 class="post-title">{title}</h2>
      <p class="post-meta">
        {t('zh', 'firstWritten')} {formatFullDate(date, 'zh')}
        <span class="min-read">{t('zh', 'minRead', { n: minutes })}</span>
      </p>
    </header>

    <div class="post-body">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <a class="post-back" href={`${import.meta.env.BASE_URL}`}>{t('zh', 'backHome')}</a>
  </article>
</Base>
