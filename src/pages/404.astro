---
/**
 * 404 页面（路径不存在）：复用 Base 布局（导航/主题/搜索/SEO/favicon），
 * 语言按 URL 前缀猜（/en/ 开 → en，否则 zh）；canonical/hreflang 指向首页避免索引垃圾。
 */
import Base from '../layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import { t } from '../lib/i18n'
import type { Lang } from '../lib/utils'

const pathname = Astro.url.pathname
const lang: Lang = pathname.startsWith('/en/') || pathname === '/en' ? 'en' : 'zh'
const base = import.meta.env.BASE_URL
const home = lang === 'zh' ? base : `${base}en/`
const desc = t(lang, 'notFoundDesc')
---

<Base
  lang={lang}
  path="/"
  description={desc}
  pageTitle={`${t(lang, 'notFoundTitle')} · ${t(lang, 'siteName')}`}
  hasTranslation={false}
>
  <article class="notfound">
    <h2 class="post-title">{t(lang, 'notFoundTitle')}</h2>
    <p class="notfound-desc">{t(lang, 'notFoundDesc')}</p>
    <a class="post-back" href={home}>
      <Icon name="lucide:arrow-left" aria-hidden="true" /> {t(lang, 'backHome')}
    </a>
  </article>
</Base>
