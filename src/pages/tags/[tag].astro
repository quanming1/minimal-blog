---
/** 标签筛选页（zh）：/tags/<tag>/ 下该标签的全部文章（日期倒序，极简表格同首页风格） */
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { sortPostsByDate } from '../../lib/posts'
import { formatMonthDay, langOfId, parseDateString, postHref } from '../../lib/utils'
import { t } from '../../lib/i18n'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id }) => langOfId(id) === 'zh')
  const byTag = new Map<string, typeof posts>()
  for (const p of posts) {
    for (const tag of p.data.tags) {
      const list = byTag.get(tag) ?? []
      list.push(p)
      byTag.set(tag, list)
    }
  }
  return Array.from(byTag.entries()).map(([tag, list]) => ({
    params: { tag },
    props: { tag, posts: list },
  }))
}

const { tag, posts } = Astro.props
const base = import.meta.env.BASE_URL
const sorted = sortPostsByDate(
  posts.map((p) => ({ p, date: parseDateString(p.data.date) })),
).map((x) => x.p)
---

<Base
  lang="zh"
  path={`/tags/${encodeURIComponent(tag)}/`}
  description={`标签「${tag}」下的文章`}
  pageTitle={`${t('zh', 'tagPostsTitle', { tag })} · ${t('zh', 'siteName')}`}
>
  <h1 class="posts-title">{t('zh', 'tagPostsTitle', { tag })}</h1>

  <table class="posts-table">
    <tbody>
      {sorted.map((p) => (
        <tr>
          <td>
            <a href={postHref(base, 'zh', p.id)}>{p.data.title}</a>
          </td>
          <td class="text-right whitespace-nowrap text-sm text-muted">
            {formatMonthDay(parseDateString(p.data.date), 'zh')}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <a class="post-back" href={`${base}tags/`}>{t('zh', 'allTags')}</a>
</Base>
