---
import '@fontsource/lato/300.css'
import '@fontsource/lato/400.css'
import '@fontsource/lato/700.css'
import '@fontsource/lato/900.css'
import '../styles/global.css'
import { t } from '../lib/i18n'
import { switchHref, type Lang } from '../lib/utils'

interface Props {
  lang: Lang
  /** 当前路径（不含语言前缀与 base），如 '/posts/hello-mingzhi/'、'/about/'、'/' */
  path: string
  title?: string
  description?: string
  /** 自定义页面标题（覆盖默认 站点名 - 页名） */
  pageTitle?: string
  /** 当前页面是否有对应语言版本（无翻译时语言切换指向首页，避免 404） */
  hasTranslation?: boolean
}

const { lang, path, description } = Astro.props

// base 如 '/minimal-blog/'（尾部带斜杠）
const base = import.meta.env.BASE_URL
const href = (p: string) => `${base}${p.replace(/^\//, '')}`

const siteTitle = t(lang, 'siteName')
const pageTitle = Astro.props.pageTitle ?? siteTitle

/** 语言切换目标：默认切换当前路径，无翻译时切到目标语言首页 */
const switchTarget = switchHref(base, lang, path, Astro.props.hasTranslation ?? true)

// 导航：文章（首页）、关于
const navLinks: { key: 'navPosts' | 'navAbout'; url: string }[] = [
  { key: 'navPosts', url: lang === 'zh' ? href('') : href('en/') },
  { key: 'navAbout', url: lang === 'zh' ? href('about/') : href('en/about/') },
]
const isHome = path === '/'
const isAbout = path === '/about/'
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? siteTitle} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      // 首帧主题：仅 localStorage 显式 'dark' 时用暗色；默认亮色（防闪烁脚本先于渲染）
      ;(function () {
        var t = null
        try {
          t = localStorage.getItem('mb-theme')
        } catch (e) {}
        if (t === 'dark') {
          document.documentElement.dataset.theme = 'dark'
        }
      })()
    </script>
  </head>
  <body>
    <div class="site">
      <header class="header">
        <h1 class="site-title">
          <a href={lang === 'zh' ? href('') : href('en/')}>{siteTitle}</a>
        </h1>
        <nav aria-label={t(lang, 'navAria')}>
          <ul>
            {navLinks.map((l) => (
              <li>
                <a
                  href={l.url}
                  aria-current={(l.key === 'navPosts' && isHome) || (l.key === 'navAbout' && isAbout) ? 'page' : undefined}
                >
                  {t(lang, l.key)}
                </a>
              </li>
            ))}
            <li class="lang-switch">
              <a href={switchTarget} title={t(lang, 'switchLang')}>{t(lang, 'switchLang')}</a>
            </li>
            <li>
              <button type="button" class="theme-toggle" id="theme-toggle" aria-label="切换主题 / toggle theme">
                <span class="theme-icon">🌙</span>
              </button>
            </li>
          </ul>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="footer">
        <p>{t(lang, 'footerNote')}</p>
        <p class="footer-meta">
          {lang === 'zh' ? (
            <>© 2026 蒋全明 · <a href={`mailto:quanming1@gmail.com`}>邮箱</a></>
          ) : (
            <>© 2026 Quanming Jiang · <a href={`mailto:quanming1@gmail.com`}>Email</a></>
          )}
        </p>
      </footer>
    </div>

    <script is:inline>
      // 主题切换（亮/暗 + localStorage 记忆）
      ;(function () {
        var btn = document.getElementById('theme-toggle')
        var icon = btn && btn.querySelector('.theme-icon')
        function apply(dark) {
          document.documentElement.dataset.theme = dark ? 'dark' : 'light'
          try {
            localStorage.setItem('mb-theme', dark ? 'dark' : 'light')
          } catch (e) {}
          if (icon) icon.textContent = dark ? '☀️' : '🌙'
        }
        if (btn) {
          var isDark = (document.documentElement.dataset.theme || 'light') === 'dark'
          if (icon) icon.textContent = isDark ? '☀️' : '🌙'
          btn.addEventListener('click', function () {
            apply((document.documentElement.dataset.theme || 'light') !== 'dark')
          })
        }
      })()
    </script>
  </body>
</html>
