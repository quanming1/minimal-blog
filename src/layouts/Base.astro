---
import '@fontsource/lato/300.css'
import '@fontsource/lato/400.css'
import '@fontsource/lato/700.css'
import '@fontsource/lato/900.css'
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { t } from '../lib/i18n'
import { switchHref, type Lang } from '../lib/utils'
import SearchDialog from '../components/SearchDialog.astro'

interface Props {
  lang: Lang
  /** 当前路径（不含语言前缀与 base），如 '/posts/hello-mingzhi/'、'/about/'、'/' */
  path: string
  title?: string
  description?: string
  /** 自定义页面标题（覆盖默认 站点名 - 页名） */
  pageTitle?: string
  /** 当前页面是否有对应语言版本（无翻译时语言切换指向首页，避免 404） */
  hasTranslation?: boolean
  /** 文章页启用阅读进度条与回到顶部 */
  reading?: boolean
}

const { lang, path, description } = Astro.props

// base 如 '/minimal-blog/'（尾部带斜杠）
const base = import.meta.env.BASE_URL
const href = (p: string) => `${base}${p.replace(/^\//, '')}`

const siteTitle = t(lang, 'siteName')
const pageTitle = Astro.props.pageTitle ?? siteTitle

/** 语言切换目标：默认切换当前路径，无翻译时切到目标语言首页 */
const switchTarget = switchHref(base, lang, path, Astro.props.hasTranslation ?? true)

// 导航：文章（首页）、关于
const navLinks: { key: 'navPosts' | 'navAbout'; url: string }[] = [
  { key: 'navPosts', url: lang === 'zh' ? href('') : href('en/') },
  { key: 'navAbout', url: lang === 'zh' ? href('about/') : href('en/about/') },
]
const isHome = path === '/'
const isAbout = path === '/about/'
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? siteTitle} />
    <!-- 安全头（GitHub Pages 无法自定义 HTTP 头，用 meta 实现 CSP 纵深防御 + 隐私 referrer）：
         script/style 保留 'unsafe-inline'（防闪烁/内联脚本/VT 内联 style/Shiki token style 必需）；
         font-src 含 data:（@fontsource/lato 被 Vite 构建为 data: URI 内联字体，'self' 会误伤）；
         frame-src/object-src/worker-src 'none' 阻止 iframe/object/Worker 副载；
         connect-src 'self' 阻止注入脚本数据外传；img-src 收紧（当前零外链图，引入时按图床域加白名单）。
         见 docs/security.md §3.1 -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <ClientRouter />
    <script is:inline>
      // 首帧主题：仅 localStorage 显式 'dark' 时用暗色；默认亮色（防闪烁脚本先于渲染）
      ;(function () {
        var t = null
        try {
          t = localStorage.getItem('mb-theme')
        } catch (e) {}
        if (t === 'dark') {
          document.documentElement.dataset.theme = 'dark'
        }
      })()
    </script>
  </head>
  <body data-reading={Astro.props.reading ? 'true' : undefined}>
    {Astro.props.reading && (
      <>
        <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
        <button
          type="button"
          class="back-to-top"
          id="back-to-top"
          aria-label="回到顶部 / Back to top"
        >
          ↑
        </button>
      </>
    )}
    <div class="site">
      <header class="header">
        <h1 class="site-title">
          <a href={lang === 'zh' ? href('') : href('en/')} transition:animate="fade">{siteTitle}</a>
        </h1>
        <nav aria-label={t(lang, 'navAria')}>
          <ul>
            {navLinks.map((l) => (
              <li>
                <a
                  href={l.url}
                  aria-current={(l.key === 'navPosts' && isHome) || (l.key === 'navAbout' && isAbout) ? 'page' : undefined}
                >
                  {t(lang, l.key)}
                </a>
              </li>
            ))}
            <li class="lang-switch">
              <a href={switchTarget} title={t(lang, 'switchLang')}>{t(lang, 'switchLang')}</a>
            </li>
            <li>
              <button type="button" class="search-open" id="search-open" aria-label={t(lang, 'searchAria')}>
                <span class="search-icon" aria-hidden>🔍</span>
              </button>
            </li>
            <li>
              <button type="button" class="theme-toggle" id="theme-toggle" aria-label="切换主题 / toggle theme">
                <span class="theme-icon" aria-hidden>🌙</span>
              </button>
            </li>
          </ul>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="footer">
        <p>{t(lang, 'footerNote')}</p>
        <p class="footer-meta">
          {lang === 'zh' ? (
            <>© 2026 蒋全明 · <a href={`mailto:quanming1@gmail.com`}>邮箱</a></>
          ) : (
            <>© 2026 Quanming Jiang · <a href={`mailto:quanming1@gmail.com`}>Email</a></>
          )}
        </p>
      </footer>
    </div>

    <!-- 组件库：Toast 通知 + 站内搜索（mb-* Web Components，见 docs/ui-analysis.md §11） -->
    <mb-toast id="toast"></mb-toast>
    <SearchDialog lang={lang} />

    <!--
      交互脚本（主题/进度条/回顶/代码复制）：
      用 astro:page-load 事件驱动——module script 只执行一次（Astro VT 脚本去重），
      每次页面导航（含 VT 切换）后触发 handler 重建绑定；清理函数防止 window 监听累积泄漏。
    -->
    <script>
      import '../components/wc/index'
      // ---- 主题 ----
      function applyTheme(dark: boolean) {
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        try {
          localStorage.setItem('mb-theme', dark ? 'dark' : 'light')
        } catch (e) {}
        const icon = document.querySelector('#theme-toggle .theme-icon')
        if (icon) icon.textContent = dark ? '☀️' : '🌙'
      }

      function readStoredTheme(): boolean {
        try {
          return localStorage.getItem('mb-theme') === 'dark'
        } catch (e) {
          return false
        }
      }

      // ---- 阅读进度 / 回顶 ----
      let scrollCleanup: (() => void) | null = null

      // ---- 全局：每次导航后初始化交互 ----
      document.addEventListener('astro:page-load', () => {
        // 1. 主题恢复：VT swap 会把 html data-theme 重置为静态值，导航后必须重放
        applyTheme(readStoredTheme())

        // 2. 主题切换按钮绑定（导航后 DOM 是新元素）
        const btn = document.getElementById('theme-toggle')
        if (btn) {
          btn.addEventListener('click', () => {
            applyTheme((document.documentElement.dataset.theme || 'light') !== 'dark')
          })
        }

        // 3. 阅读进度条 + 回到顶部（仅文章页）
        if (scrollCleanup) {
          scrollCleanup()
          scrollCleanup = null
        }
        if (document.body.dataset.reading === 'true') {
          const bar = document.getElementById('reading-progress')
          const topBtn = document.getElementById('back-to-top')
          let ticking = false
          const update = () => {
            const doc = document.documentElement
            const max = doc.scrollHeight - window.innerHeight
            const p = max > 0 ? Math.min(1, window.scrollY / max) : 0
            if (bar) bar.style.width = `${(p * 100).toFixed(1)}%`
            if (topBtn) topBtn.classList.toggle('visible', window.scrollY > 600)
            ticking = false
          }
          const onScroll = () => {
            if (!ticking) {
              ticking = true
              requestAnimationFrame(update)
            }
          }
          window.addEventListener('scroll', onScroll, { passive: true })
          update()
          scrollCleanup = () => window.removeEventListener('scroll', onScroll)

          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
          topBtn?.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
          })
        }

        // 4. 代码块增强：语言标签 + 复制按钮
        const isZh = (document.documentElement.lang || '').startsWith('zh')
        const copyLabel = isZh ? '复制' : 'Copy'
        const copiedLabel = isZh ? '已复制' : 'Copied'
        const blocks = document.querySelectorAll('.post-body pre.astro-code')
        blocks.forEach((pre) => {
          if (!(pre instanceof HTMLElement) || pre.querySelector('.code-actions')) return
          pre.classList.add('has-actions')
          const actions = document.createElement('div')
          actions.className = 'code-actions'

          const lang = pre.getAttribute('data-language') ?? ''
          if (lang && lang !== 'plaintext') {
            const label = document.createElement('span')
            label.className = 'code-lang'
            label.textContent = lang
            actions.appendChild(label)
          }

          const copyBtn = document.createElement('button')
          copyBtn.type = 'button'
          copyBtn.className = 'code-copy'
          copyBtn.textContent = copyLabel
          copyBtn.setAttribute('aria-label', `${copyLabel} code`)
          const toastEl = document.querySelector<HTMLElement & { show: (m: string, o?: { duration?: number }) => void }>('mb-toast')
          let labelTimer: ReturnType<typeof setTimeout> | null = null
          const feedback = (ok: boolean) => {
            const msg = ok ? copiedLabel : isZh ? '复制失败' : 'Failed'
            // 按钮文字保持 '复制'，反馈走 mb-toast（aria-label 同步读屏）
            copyBtn.setAttribute('aria-label', `${msg} code`)
            toastEl?.show(msg)
            // 防连续复制时多个 timer 竞态提前还原 aria-label
            if (labelTimer) clearTimeout(labelTimer)
            labelTimer = setTimeout(() => {
              copyBtn.setAttribute('aria-label', `${copyLabel} code`)
              labelTimer = null
            }, 1500)
          }
          const doCopy = () => {
            const text = pre.querySelector('code')?.innerText ?? ''
            const fallback = () => {
              const ta = document.createElement('textarea')
              ta.value = text
              ta.style.position = 'fixed'
              ta.style.opacity = '0'
              document.body.appendChild(ta)
              ta.select()
              const ok = document.execCommand('copy')
              document.body.removeChild(ta)
              feedback(ok)
            }
            if (navigator.clipboard?.writeText) {
              navigator.clipboard.writeText(text).then(
                () => feedback(true),
                () => fallback(),
              )
            } else {
              fallback()
            }
          }
          copyBtn.addEventListener('click', doCopy)
          actions.appendChild(copyBtn)
          pre.appendChild(actions)
        })
      })
    </script>
  </body>
</html>
