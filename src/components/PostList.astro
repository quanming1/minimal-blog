---
/** 首页文章列表：年份分组 + 极简表格（标题 | 日期）+ ¶ 锚点（olivierlacan 风格） */
import { t } from '../lib/i18n'
import { formatMonthDay, groupByYear, postHref, type Lang } from '../lib/utils'

interface Props {
  lang: Lang
  posts: { id: string; title: string; date: Date }[]
}

const { lang, posts } = Astro.props
const base = import.meta.env.BASE_URL
const years = groupByYear(posts)
---

<h1 class="posts-title">{t(lang, 'postsTitle')}</h1>

{years.map((g) => (
  <section class="year-group">
    <h2 id={`${g.year}-ref`}>
      {g.year}
      <a href={`#${g.year}-ref`} aria-label={`${g.year}`}>¶</a>
    </h2>
    <table class="posts-table">
      <tbody>
        {g.posts.map((p) => (
          <tr>
            <td>
              <a href={postHref(base, lang, p.id)}>{p.title}</a>
            </td>
            <td>{formatMonthDay(p.date, lang)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
))}
