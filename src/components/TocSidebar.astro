---
/** 文章目录：大屏（≥1201px）右侧 sticky 侧栏，小屏折叠展开；滚动高亮当前章节（astro:page-load 驱动，VT 导航后重建） */
import { buildToc, type HeadingLike } from '../lib/toc'
import type { Lang } from '../lib/utils'

interface Props {
  headings: HeadingLike[]
  lang: Lang
}

const { headings, lang } = Astro.props
const items = buildToc(headings)
const tocLabel = lang === 'zh' ? '目录' : 'Contents'
---

{items.length > 1 && (
  <nav class="toc-wrap" aria-label={tocLabel}>
    <details class="toc" open>
      <summary>{tocLabel}</summary>
      <ul>
        {items.map((item) => (
          <li class={`toc-item toc-d${item.depth}`}>
            <a href={`#${item.id}`}>{item.text}</a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<script>
  // TOC 交互（滚动高亮 + 大屏强制展开）：astro:page-load 每次导航后重建，旧 observer/监听先清理
  let tocObserver: IntersectionObserver | null = null
  let mqCleanup: (() => void) | null = null

  document.addEventListener('astro:page-load', () => {
    tocObserver?.disconnect()
    tocObserver = null
    if (mqCleanup) {
      mqCleanup()
      mqCleanup = null
    }

    const toc = document.querySelector<HTMLDetailsElement>('.toc')
    if (!toc || !('IntersectionObserver' in window)) return

    // 大屏（≥1201px）强制展开：防止小屏折叠后拉宽导致目录不可见
    const mq = window.matchMedia('(min-width: 1201px)')
    const ensureOpen = () => {
      if (mq.matches) toc.open = true
    }
    ensureOpen()
    mq.addEventListener('change', ensureOpen)
    mqCleanup = () => mq.removeEventListener('change', ensureOpen)

    // 滚动高亮：视口顶部 30% 内的最靠上章节；顶部（标题区占满）时清除高亮
    const links = Array.from(toc.querySelectorAll('a'))
    const targets = links
      .map((a) => document.getElementById(a.getAttribute('href')?.slice(1) ?? ''))
      .filter((el): el is HTMLElement => el !== null)

    const setActive = (id: string | null) => {
      for (const a of links) {
        const active = a.getAttribute('href') === `#${id}`
        a.classList.toggle('active', active)
        if (active) a.setAttribute('aria-current', 'true')
        else a.removeAttribute('aria-current')
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        setActive(visible[0]?.target.id ?? null)
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    )
    for (const t of targets) observer.observe(t)
    tocObserver = observer
  })
</script>
