---
/** 站内搜索对话框（v1.3.0）：mb-dialog 容器 + 搜索 UI + 键盘导航
 * - SSG 构建期生成索引（zh+en 全部文章），内联 JSON
 * - Cmd+K / Ctrl+K 或导航栏 🔍 按钮触发
 * - 过滤纯函数 filterPosts（src/lib/search.ts，单测覆盖）
 * - 键盘导航：焦点驻留 input，aria-activedescendant 指示选中（APG listbox 模式）
 * 见 docs/ui-analysis.md §11.3
 */
import { getCollection } from 'astro:content'
import { buildSearchIndex, serializeIndexForHtml } from '../lib/search'
import { t } from '../lib/i18n'
import { postHref, type Lang } from '../lib/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const base = import.meta.env.BASE_URL

const posts = await getCollection('posts')
const index = buildSearchIndex(
  posts.map((p) => ({
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
    href: postHref(base, lang, p.id),
    date: p.data.date,
  })),
)
// 全量转义 <（覆盖 </script> 与 <!-- 两种注入向量），serializeIndexForHtml 单测覆盖（search.test.ts）
const indexJson = serializeIndexForHtml(index)
---

<mb-dialog id="search-dialog" label={t(lang, 'searchTitle')}>
  <div class="search-panel">
    <div class="search-head">
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder={t(lang, 'searchPlaceholder')}
        aria-label={t(lang, 'searchPlaceholder')}
        autocomplete="off"
      />
      <span class="search-esc" aria-hidden="true">Esc</span>
    </div>
    <p id="search-empty" class="search-empty" hidden>{t(lang, 'searchEmpty')}</p>
    <ul id="search-results" class="search-results" role="listbox" aria-label={t(lang, 'searchResults')} aria-activedescendant=""></ul>
  </div>
</mb-dialog>

<!-- is:inline + set:html：type=application/json 的 script 会被 Astro 透传，必须显式求值注入真实 JSON -->
<script type="application/json" id="search-index" data-search-index is:inline set:html={indexJson}></script>

<style>
  .search-panel {
    display: flex;
    flex-direction: column;
    gap: 0.8em;
  }
  .search-head {
    display: flex;
    align-items: center;
    gap: 0.6em;
    border-bottom: 1px solid var(--divider);
    padding-bottom: 0.6em;
    transition: border-bottom-color 0.15s ease;
  }
  .search-head:focus-within {
    border-bottom-color: var(--accent); /* 下划线式输入框的聚焦指示（配合全局 :focus-visible 兜底） */
  }
  .search-input {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 1.1em;
    line-height: 1.6;
    color: var(--text);
    background: none;
    border: none;
    padding: 0.2em 0;
  }
  .search-input:focus {
    outline: none; /* 聚焦指示由 .search-head:focus-within 承担，避免双环 */
  }
  .search-esc {
    flex-shrink: 0;
    font-size: 0.72em;
    color: var(--muted);
    border: 1px solid var(--divider);
    border-radius: 3px;
    padding: 0.1em 0.45em;
    line-height: 1.4;
  }
  .search-empty {
    color: var(--muted);
    font-size: 0.95em;
    margin: 0.2em 0;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 46vh;
    overflow-y: auto;
  }
  .search-item {
    border-bottom: 1px solid var(--divider);
  }
  .search-item:last-child {
    border-bottom: none;
  }
  .search-item a {
    display: block;
    border-bottom: none;
    padding: 0.55em 0.3em;
    color: var(--text);
    font-weight: 700;
    font-size: 0.98em;
    line-height: 1.4;
  }
  .search-item .search-desc {
    display: block;
    color: var(--muted);
    font-size: 0.85em;
    line-height: 1.5;
    margin: 0 0.3em 0.55em;
  }
  .search-item a:hover,
  .search-item[aria-selected='true'] a {
    color: var(--accent);
    background: var(--code-bg);
  }
</style>

<script>
  import { filterPosts } from '../lib/search'
  import type { SearchEntry } from '../lib/search'

  // Cmd+K 全局监听：跨 VT 导航只保留一份（模块级单例 + 清理，防累积泄漏）
  let keydownCleanup: (() => void) | null = null

  document.addEventListener('astro:page-load', () => {
    if (keydownCleanup) {
      keydownCleanup()
      keydownCleanup = null
    }

    const dialog = document.getElementById('search-dialog') as HTMLElement | null
    const input = document.getElementById('search-input') as HTMLInputElement | null
    const results = document.getElementById('search-results') as HTMLElement | null
    const empty = document.getElementById('search-empty') as HTMLElement | null
    const openBtn = document.getElementById('search-open')
    const indexScript = document.getElementById('search-index')
    if (!dialog || !input || !results || !empty || !indexScript) return

    let index: SearchEntry[]
    try {
      index = JSON.parse(indexScript.textContent ?? '[]')
    } catch {
      return // 索引损坏时安全退化：搜索不可用，不影响其余交互（主题/进度条等独立 listener）
    }
    let activeIdx = -1

    /** 更新选中项：aria-selected + aria-activedescendant（焦点驻留 input，不移动） */
    const setActive = (i: number) => {
      activeIdx = i
      const items = Array.from(results.querySelectorAll<HTMLElement>('.search-item'))
      items.forEach((li, idx) => li.setAttribute('aria-selected', String(idx === i)))
      const active = items[i]
      results.setAttribute('aria-activedescendant', active ? active.id : '')
    }

    const open = () => {
      if (!dialog.hasAttribute('open')) dialog.setAttribute('open', '')
      input.value = ''
      render('')
      // 焦点由 mb-dialog 自动聚焦首个可聚焦元素（input）
    }
    const close = () => dialog.removeAttribute('open')

    const render = (q: string) => {
      const items = filterPosts(index, q)
      results.innerHTML = ''
      // 空态：未输入不显示；有输入无匹配才显示
      empty.hidden = q.trim() === '' || items.length > 0
      items.forEach((item, i) => {
        const li = document.createElement('li')
        li.className = 'search-item'
        li.id = `search-item-${i}`
        li.setAttribute('role', 'option')
        li.setAttribute('aria-selected', 'false')
        const a = document.createElement('a')
        a.href = item.href
        a.textContent = item.title
        li.appendChild(a)
        if (item.description) {
          const d = document.createElement('span')
          d.className = 'search-desc'
          d.textContent = item.description
          li.appendChild(d)
        }
        results.appendChild(li)
      })
      setActive(-1)
    }

    // 触发入口：🔍 按钮 + Cmd/Ctrl+K
    openBtn?.addEventListener('click', open)
    const onKeydown = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault()
        if (dialog.hasAttribute('open')) close()
        else open()
      }
    }
    window.addEventListener('keydown', onKeydown)
    keydownCleanup = () => window.removeEventListener('keydown', onKeydown)

    // 输入过滤
    input.addEventListener('input', () => render(input.value))

    // 键盘导航（焦点驻留 input，APG listbox + aria-activedescendant）
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      const items = Array.from(results.querySelectorAll<HTMLElement>('.search-item'))
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault()
        if (items.length === 0) return
        const next = e.key === 'ArrowDown' ? Math.min(activeIdx + 1, items.length - 1) : Math.max(activeIdx - 1, -1)
        setActive(next)
        items[next]?.scrollIntoView({ block: 'nearest' })
      } else if (e.key === 'Enter') {
        // activeIdx=-1（未导航过）时兜底打开第一条
        const target = items[activeIdx] ?? items[0]
        const a = target?.querySelector('a')
        if (a) a.click() // 触发 VT 软导航（与鼠标点击一致，不绕过 ClientRouter）
      }
    })
  })
</script>
