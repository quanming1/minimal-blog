  "version": "1.3.0",
  "description": "Minimal blog - MD-driven static site, olivierlacan-style, bilingual (zh/en), light/dark themes",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
